# Local SQLite database. In Docker use file:/data/selamcode.db.
DATABASE_URL="file:./dev.db"

# Optional: without a key, clearly labeled offline tutoring templates are used.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# preview = deterministic static checks, NEVER executes Python.
# sandbox = isolated Docker container; requires Docker and the runner image.
EXECUTION_MODE="preview"
SANDBOX_IMAGE="selamcode-python:latest"
EXECUTION_TIMEOUT_MS="6000"

# Explicitly opt in to local demo accounts. Never enable on a public deployment.
DEMO_AUTH_ENABLED="false"
SEED_DEMO_ACCOUNTS="false"
DEMO_PASSWORD="SelamDemo2026!"
# Required only when registering an instructor. Keep this secret.
INSTRUCTOR_INVITE_CODE=""
# Set false only for a local HTTP production preview; use true with HTTPS.
SESSION_COOKIE_SECURE="true"

# Stable, secret salt for anonymous research IDs. Set a long random value.
RESEARCH_SALT=""
# Optional public origin for deployments behind a reverse proxy.
APP_URL=""
