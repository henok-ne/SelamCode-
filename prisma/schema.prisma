generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  displayName  String      @map("display_name")
  role         String      @default("student")
  createdAt    DateTime    @default(now()) @map("created_at")
  submissions  Submission[]
  sessions     Session[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}

model Exercise {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  difficulty      String
  description     String
  starterCode     String   @map("starter_code")
  expectedOutput  String   @map("expected_output")
  testCasesJson   String   @map("test_cases_json")
  conceptTagsJson String   @map("concept_tags_json")
  functionName    String   @map("function_name")
  createdAt       DateTime @default(now()) @map("created_at")
  submissions     Submission[]
  @@map("exercises")
}

model Submission {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  exerciseId     String   @map("exercise_id")
  code           String
  status         String
  runtimeOutput  String   @map("runtime_output")
  errorMessage   String?  @map("error_message")
  executionMode  String   @default("preview") @map("execution_mode")
  testResultsJson String  @map("test_results_json")
  isFinal        Boolean  @default(false) @map("is_final")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  hints          HintRequest[]
  @@index([userId, exerciseId, createdAt])
  @@map("submissions")
}

model HintRequest {
  id                String   @id @default(cuid())
  submissionId      String   @map("submission_id")
  hintLevel         String   @map("hint_level")
  category          String   @default("debugging")
  promptContextJson String   @map("prompt_context_json")
  aiResponse        String   @map("ai_response")
  wasHelpful        Boolean? @map("was_helpful")
  language          String   @default("en")
  provider          String   @default("offline")
  notice            String?
  createdAt         DateTime @default(now()) @map("created_at")
  submission        Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  feedback          FeedbackEvent[]
  @@unique([submissionId, hintLevel])
  @@map("hint_requests")
}

model FeedbackEvent {
  id            String   @id @default(cuid())
  hintRequestId String   @map("hint_request_id")
  rating        Boolean
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  hintRequest   HintRequest @relation(fields: [hintRequestId], references: [id], onDelete: Cascade)
  @@index([hintRequestId])
  @@map("feedback_events")
}
